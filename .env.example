# ---- 项目标识 ----
COMPOSE_PROJECT_NAME=policyfit

# ---- 端口（题目分配，不可改）----
FRONTEND_PORT=18200
BACKEND_PORT=19200
DB_PORT=17700

# ---- 数据库 ----
DB_NAME=policyfit
DB_USER=policyfit
DB_PASSWORD=policyfit_pw_2026
DB_ROOT_PASSWORD=policyfit_root_2026

# ---- 安全 ----
JWT_SECRET=policyfit-jwt-secret-change-me-2026

# ---- 运行时 ----
REDIS_URL=redis://redis:6379/0
SEED_DEMO=true
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_WRITE_PER_MINUTE=60
# 业务时区（展示时间按 UTC+8 解释）
APP_TIMEZONE_OFFSET_MINUTES=480
